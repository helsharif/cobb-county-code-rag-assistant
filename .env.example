# Copy this file to .env locally and fill in the values you want to use.
# Do not commit .env.

# Required for default OpenAI LLM and embeddings.
OPEN_API_KEY=

# Optional Gemini provider.
GEMINI_API_KEY=

# Provider choices: openai or gemini
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# Model choices
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# RAG tuning. These are character counts, roughly 500-1000 tokens per chunk.
CHROMA_COLLECTION_NAME=cobb_code_docs_original
STREAMLIT_HOST_PORT=8502
CHUNK_SIZE=3500
CHUNK_OVERLAP=500
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_DELAY_SECONDS=1.0
EMBEDDING_MAX_RETRIES=8
RETRIEVER_K=10
MIN_RELEVANCE_SCORE=0.30

# Deterministic context expansion after retrieval and before evidence gating/generation.
CONTEXT_EXPANSION_ENABLED=true
CONTEXT_EXPANSION_MODE=neighbors
CONTEXT_NEIGHBOR_WINDOW=1
CONTEXT_MAX_EXPANDED_DOCS=8
CONTEXT_MAX_CHARS=18000
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_TOP_N=8
RERANKER_BATCH_SIZE=16
RERANKER_MIN_SCORE=0.0

# Option 3/4 local BM25 hybrid retrieval.
BM25_INDEX_FILE=docling_bm25_chunks.json

# Docling PDF parsing. Use cuda locally when a CUDA-enabled PyTorch install is available.
DOCLING_ACCELERATOR_DEVICE=auto
DOCLING_NUM_THREADS=4
DOCLING_DO_OCR=false
DOCLING_BATCH_SIZE=1
DOCLING_MAX_PAGES=250
DOCLING_PAGE_CHUNK_SIZE=30
DOCLING_PAGE_OVERLAP=5

# Required for Settings & Eval LangSmith evaluation. Tracing can be disabled if desired.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=cobb-county-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
EVAL_JUDGE_MODEL=gpt-5.1
EVAL_JUDGE_DELAY_SECONDS=1.0
EVAL_JUDGE_MAX_RETRIES=8

# Optional placeholder for hosted Chroma setups. Local Chroma does not require it.
CHROMA_API_KEY=

# Required for Google web fallback through SerpAPI.
SERPAPI_API_KEY=
ALLOWED_WEB_DOMAINS=cobbcounty.gov,www.cobbcounty.org,cobbcountyga.gov,dca.georgia.gov,oci.georgia.gov,rules.sos.ga.gov

# Option 5: RAG-Anything + LightRAG KG Search.
# This writes only under vectorstore/rag_anything_lightrag_option5 by default.
OPTION5_ENABLED=true
RAG_ANYTHING_OPTION5_STORAGE_DIR=vectorstore/rag_anything_lightrag_option5
RAG_ANYTHING_OPTION5_OUTPUT_DIR=vectorstore/rag_anything_lightrag_option5/processed
RAG_ANYTHING_OPTION5_ALLOW_EXTERNAL_DIRS=false
RAG_ANYTHING_PARSER=docling
RAG_ANYTHING_PARSE_METHOD=auto
RAG_ANYTHING_FILE_EXTENSIONS=.pdf,.html,.htm,.md,.txt,.docx,.xlsx
RAG_ANYTHING_ENABLE_IMAGE_PROCESSING=false
RAG_ANYTHING_ENABLE_TABLE_PROCESSING=true
RAG_ANYTHING_ENABLE_EQUATION_PROCESSING=false
RAG_ANYTHING_SECTION_RELATIONS=true
RAG_ANYTHING_MAX_CONCURRENT_FILES=3
RAG_ANYTHING_DOCLING_TABLES=true
RAG_ANYTHING_RETRY_WITHOUT_TABLES=true
RAG_ANYTHING_DOCLING_TABLE_MODE=fast
ENABLE_PRE_EXTRACTION_CHUNKING=true
TARGET_EXTRACTION_CHUNK_TOKENS=4000
MAX_EXTRACTION_CHUNK_TOKENS=7000
SAVE_OVERSIZED_ITEM_AUDIT=true
OVERSIZED_ITEM_AUDIT_DIR=vectorstore/rag_anything_lightrag_option5/audit/oversized_items
LIGHTRAG_WORKING_DIR=vectorstore/rag_anything_lightrag_option5/lightrag
LIGHTRAG_MODE=mix
LIGHTRAG_TOP_K=10
LIGHTRAG_CHUNK_TOP_K=10
LIGHTRAG_MAX_TOTAL_TOKENS=12000
LIGHTRAG_RERANK_ENABLED=true
LIGHTRAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
LIGHTRAG_MIN_RERANK_SCORE=0.0
LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
LIGHTRAG_LLM_MODEL=gpt-4.1-mini
OPTION5_WEB_FALLBACK_ENABLED=true
